#!/usr/bin/env python3
"""
Spotify Liquid Glass Widget (Apple macOS Glassmorphism Edition)
Widget flotante Always-on-Top de alto rendimiento con desenfoque de vidrio líquido,
controles MPRIS en tiempo real, esquinas squircle, modo píldora y redimensionamiento por esquina.
"""

import os
import sys
import socket

# Forzar backend X11 bajo Wayland para garantizar Always-on-Top (keep_above) incondicional
if 'GDK_BACKEND' not in os.environ:
    os.environ['GDK_BACKEND'] = 'x11'

SOCKET_PATH = f"/tmp/spotify_glass_{os.getuid()}.sock"

def check_single_instance():
    """Si ya existe una instancia abierta, la trae al frente o procesa comandos CLI."""
    cmd = "SHOW"
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("--center", "-c", "center"):
            cmd = "CENTER"
        elif arg in ("--toggle", "-t", "toggle"):
            cmd = "TOGGLE"
        elif arg in ("--pill", "-p", "pill"):
            cmd = "PILL"
        elif arg in ("--card", "card"):
            cmd = "CARD"
        elif arg in ("--status", "-s", "status"):
            cmd = "STATUS"
        elif arg in ("--sync", "sync"):
            cmd = "SYNC"
        elif arg in ("--show", "show"):
            cmd = "SHOW"

    if os.path.exists(SOCKET_PATH):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(SOCKET_PATH)
            s.sendall(f"{cmd}\n".encode())
            if cmd == "STATUS":
                print(s.recv(4096).decode())
            s.close()
            sys.exit(0)
        except (socket.error, ConnectionRefusedError):
            try:
                os.unlink(SOCKET_PATH)
            except OSError:
                pass

check_single_instance()

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('Gio', '2.0')
gi.require_version('GLib', '2.0')

try:
    gi.require_version('AyatanaAppIndicator3', '0.1')
    from gi.repository import AyatanaAppIndicator3
    HAS_APP_INDICATOR = True
except Exception:
    HAS_APP_INDICATOR = False

from gi.repository import Gtk, Gdk, Gio, GLib, GdkPixbuf
import urllib.request
import threading
import json
import cairo

GLib.set_prgname("spotify-glass-widget")
GLib.set_application_name("Spotify Liquid Glass")

