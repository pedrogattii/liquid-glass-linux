<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.liquid-island" path="/org/gnome/shell/extensions/liquid-island/">
    <key name="manage-legacy-widget" type="b"><default>false</default><summary>Migrar el widget anterior tras activar la isla</summary></key>
    <key name="legacy-was-enabled" type="b"><default>false</default><summary>Estado de inicio previo del widget</summary></key>
    <key name="legacy-was-active" type="b"><default>false</default><summary>Estado de ejecución previo del widget</summary></key>
    <key name="legacy-suspended" type="b"><default>false</default><summary>El widget anterior fue suspendido por la isla</summary></key>
    <key name="appearance" type="s">
      <choices><choice value="auto"/><choice value="light"/><choice value="dark"/></choices>
      <default>'auto'</default>
      <summary>Apariencia del cristal</summary>
      <description>auto sigue el esquema de color del escritorio.</description>
    </key>
    <key name="blur-strength" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.85</default>
      <summary>Intensidad del desenfoque</summary>
    </key>
    <key name="desktop-style" type="b">
      <default>true</default>
      <summary>Aplicar el material al escritorio</summary>
      <description>Distribuye la barra en grupos de cristal, añade el dock y armoniza los menús y actividades.</description>
    </key>
    <key name="toggle-island" type="as">
      <default>['&lt;Super&gt;i']</default>
      <summary>Atajo para desplegar la isla</summary>
    </key>
    <key name="island-position" type="s">
      <choices>
        <choice value="center"/>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'center'</default>
      <summary>Horizontal position on top bar: center, left, right</summary>
    </key>
    <key name="island-width" type="i">
      <range min="360" max="580"/>
      <default>430</default>
      <summary>Expanded island width in px</summary>
    </key>
    <key name="pill-scale" type="d">
      <range min="0.85" max="1.30"/>
      <default>1.0</default>
      <summary>Compact pill scale factor</summary>
    </key>
    <key name="island-offset-y" type="i">
      <range min="0" max="28"/>
      <default>8</default>
      <summary>Vertical offset from top bar in px</summary>
    </key>
    <key name="enable-animations" type="b">
      <default>true</default>
      <summary>Enable spring animations</summary>
    </key>
    <key name="animation-speed" type="d">
      <range min="0.5" max="2.0"/>
      <default>1.0</default>
      <summary>Animation speed multiplier</summary>
    </key>
    <key name="color-scheme" type="s">
      <default>'default'</default>
      <summary>Color scheme override</summary>
    </key>
    <key name="show-banners" type="b">
      <default>true</default>
      <summary>Show floating notification banners</summary>
    </key>
    <key name="clock-use-24h" type="b">
      <default>true</default>
      <summary>Use 24-hour clock format</summary>
    </key>
    <key name="clock-show-seconds" type="b">
      <default>false</default>
      <summary>Show seconds in compact clock</summary>
    </key>
    <key name="clock-show-date" type="b">
      <default>true</default>
      <summary>Show short date next to clock in compact pill</summary>
    </key>
    <key name="calendar-week-start" type="i">
      <range min="0" max="1"/>
      <default>1</default>
      <summary>First day of week: 1 = Monday, 0 = Sunday</summary>
    </key>
    <key name="dynamic-album-accent" type="b">
      <default>true</default>
      <summary>Extract dominant accent color from album art</summary>
    </key>
    <key name="custom-accent-color" type="s">
      <default>'#5ac8fa'</default>
      <summary>Custom accent hex color</summary>
    </key>
    <key name="glass-opacity" type="d">
      <range min="0.15" max="0.90"/>
      <default>0.42</default>
      <summary>Glass surface opacity</summary>
    </key>
    <key name="corner-radius" type="i">
      <range min="14" max="40"/>
      <default>28</default>
      <summary>Island corner radius in px</summary>
    </key>
    <key name="show-telemetry-pill" type="b">
      <default>false</default>
      <summary>Show CPU/RAM telemetry in compact top pill</summary>
    </key>
    <key name="show-telemetry-panel" type="b">
      <default>true</default>
      <summary>Show CPU/RAM/Temp telemetry card in expanded island</summary>
    </key>
    <key name="show-quick-controls" type="b">
      <default>true</default>
      <summary>Show Quick Controls and Pinned Apps in expanded island</summary>
    </key>
    <key name="pinned-island-apps" type="as">
      <default>['org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Settings.desktop', 'com.spotify.Client.desktop']</default>
      <summary>Desktop IDs pinned in Island Quick Launcher</summary>
    </key>
    <key name="dock-intellihide" type="b">
      <default>true</default>
      <summary>Reveal dock when cursor touches bottom screen edge</summary>
    </key>
    <key name="dock-magnification" type="b">
      <default>true</default>
      <summary>Magnify dock icons on hover like macOS</summary>
    </key>
    <key name="dock-icon-size" type="i">
      <range min="32" max="64"/>
      <default>46</default>
      <summary>Dock icon size in px</summary>
    </key>
    <key name="dock-max-apps" type="i">
      <range min="6" max="28"/>
      <default>18</default>
      <summary>Maximum apps displayed in dock</summary>
    </key>
    <key name="dock-show-running" type="b">
      <default>true</default>
      <summary>Show running unpinned apps in dock</summary>
    </key>
    <key name="dock-show-apps-button" type="b">
      <default>true</default>
      <summary>Show All Applications grid button in dock</summary>
    </key>
    <key name="island-module-order" type="as">
      <default>['music', 'quick', 'telemetry', 'notifications', 'calendar']</default>
      <summary>Order of expanded island modules</summary>
    </key>
    <key name="music-show-island" type="b">
      <default>true</default>
      <summary>Show media in island</summary>
    </key>
    <key name="music-show-widget" type="b">
      <default>true</default>
      <summary>Show automatic desktop music widget</summary>
    </key>
    <key name="dock-position" type="s"><choices><choice value="bottom"/><choice value="top"/><choice value="left"/><choice value="right"/></choices>
      <default>'bottom'</default>
      <summary>Dock edge: bottom, top, left or right</summary>
    </key>
    <key name="panel-left-order" type="as">
      <default>['activities', 'liquidLauncher', 'liquidContext']</default>
      <summary>Left panel group order</summary>
    </key>
    <key name="panel-right-order" type="as">
      <default>['appindicators', 'keyboard', 'a11y', 'quickSettings']</default>
      <summary>Right panel group order</summary>
    </key>
    <key name="widgets-enabled" type="as">
      <default>['music']</default>
      <summary>Enabled native desktop widgets</summary>
    </key>
    <key name="widget-layout" type="s">
      <default>'{"version":1,"widgets":{}}'</default>
      <summary>Versioned desktop widget layout</summary>
    </key>
    <key name="widgets-edit-mode" type="b">
      <default>false</default>
      <summary>Show widget move and resize controls</summary>
    </key>
    <key name="widget-snap-to-grid" type="b">
      <default>true</default>
      <summary>Snap widget geometry to grid</summary>
    </key>
    <key name="widget-notes" type="s">
      <default>''</default>
      <summary>Local widget notes</summary>
    </key>
    <key name="widget-tasks" type="s">
      <default>'[]'</default>
      <summary>Local widget tasks JSON</summary>
    </key>
    <key name="widget-timer-seconds" type="i"><range min="1" max="86400"/>
      <default>1500</default>
      <summary>Timer duration in seconds</summary>
    </key>
    <key name="widget-weather-location" type="s">
      <default>''</default>
      <summary>Serialized GWeather location; empty uses system weather location</summary>
    </key>
    <key name="toggle-widget-edit" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;w']</default>
      <summary>Toggle desktop widget editing</summary>
    </key>
    <key name="messaging-bubbles" type="b"><default>true</default><summary>Style messaging notifications as native glass bubbles</summary></key>
    <key name="messaging-apps" type="as"><default>['discord.desktop', 'com.discordapp.Discord.desktop', 'org.telegram.desktop.desktop', 'org.signal.Signal.desktop', 'whatsapp.desktop']</default><summary>Messaging desktop IDs receiving glass notification bubbles</summary></key>
  </schema>
</schemalist>
